BasedOnStyle: Google
IndentWidth: 4
TabWidth: 4
UseTab: Never

# --- General formatting ---
ColumnLimit: 100
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# --- Braces and blocks ---
BreakBeforeBraces: Attach
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: InlineOnly

# --- Pointers, references ---
PointerAlignment: Left
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: true
DerivePointerAlignment: false

# --- Templates and lambdas ---
AlwaysBreakTemplateDeclarations: Yes

# --- Includes ---
SortIncludes: true
IncludeBlocks: Regroup

IncludeCategories:
  - Regex: '^"[^"]*/[^"]*\.h"'                     # Matching header
    Priority: 1
  - Regex: '^"thesis/.*"'                          # Project headers
    Priority: 2
  - Regex: '^"(CLI11|spdlog|stb|tinyexr)/.*"'      # Third-party headers
    Priority: 3
  - Regex: '^<((optix|cuda|vector_types)[^>]*)>'   # OptiX / CUDA / vector_types.h
    Priority: 4
  - Regex: '^<.*>'                                 # Standard/system headers
    Priority: 5

# --- Comments ---
ReflowComments: true

# --- Trailing commas ---
Cpp11BracedListStyle: true
